# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mytree_db"

# Session signing secret (required in production). Generate with: openssl rand -base64 48
JWT_SECRET=""

# Optional: serve the app under a sub-path of a shared domain (e.g. https://host/mytree).
# Leave empty to serve from the domain root. Baked in at build time: rebuild after changing.
BASE_PATH=""

# Optional: absolute folder for uploaded images, outside the home folder (e.g. /var/lib/mytree/uploads).
# The app user must be able to write to it. Defaults to ./public/uploads.
UPLOAD_DIR=""
